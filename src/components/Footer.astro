---
import Default from "@astrojs/starlight/components/Footer.astro";
import {getLangFromUrl, useTranslations} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Default><slot /></Default>
<div class="flex flex-col gap-8">
  <div class="flex flex-col gap-4">
    <div class="text-gray-500">{t("footer.fundingFrom")}:</div>
    <div
      class="flex flex-wrap gap-5 md:gap-10 items-start dark:bg-white dark:px-4 py-5 rounded-xl"
    >
      <a href="https://www.bmbf.de" target="_blank">
        <img
          src={lang === "de" ? "/BMFTR-de.webp" : "/BMFTR-en.webp"}
          alt="Bundesministerium für Forschung, Technologie und Raumfahrt"
          class="h-20 w-auto block"
        />
      </a>
      <a href="https://prototypefund.de" target="_blank">
        <img
          src="/PrototypeFund.png"
          alt="Prototype Fund"
          class="h-10 w-auto block"
        />
      </a>
    </div>
  </div>

  <div class="flex flex-wrap gap-x-4">
    <a href={lang === "de" ? "/de/imprint" : "/imprint"}
      >{t("footer.imprint")}</a
    >
    <a href={lang === "de" ? "/de/privacy" : "/privacy"}
      >{t("footer.privacy")}</a
    >
    <a href={lang === "de" ? "/de/press" : "/press"}>{t("footer.press")}</a>
    <a
      href={lang === "de"
        ? "/de/community/practice-newsletter"
        : "/community/practice-newsletter"}>{t("footer.practiceNewsletter")}</a
    >
  </div>
</div>
