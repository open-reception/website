---
import {getLangFromUrl, useTranslations} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a
  class="bg-[var(--primary)] text-white dark:bg-[var(--sl-color-white)] dark:text-[var(--primary)] no-underline block ml-auto! text-sm px-2 py-1 rounded-sm hover:text-[var(--ring)] dark:hover:text-[var(--primary)] dark:hover:bg-[var(--border)]"
  href={lang === "de" ? "/de/getting-started" : "/getting-started"}
>
  {t("header.getStsarted")}
</a>
